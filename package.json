{
  "name": "@sapirrior/sonnet-cli",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Sonnet — an AI coding agent for your terminal",
  "bin": {
    "sonnet": "dist/bin/cli.js",
    "snt": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "src/assets/",
    "README.md",
    "CONTRIBUTING.md",
    "package.json"
  ],
  "keywords": [
    "cli",
    "ai",
    "sonnet",
    "engineering",
    "terminal",
    "agent",
    "coding"
  ],
  "homepage": "https://github.com/sapirrior/sonnet#readme",
  "bugs": {
    "url": "https://github.com/sapirrior/sonnet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapirrior/sonnet.git"
  },
  "license": "MIT",
  "author": "nolan stark",
  "type": "module",
  "main": "./dist/src/core/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node node_modules/typescript/bin/tsc && cp -r src/packages/config/configs dist/src/packages/config/ && cp -r src/assets dist/src/",
    "start": "node dist/bin/cli.js",
    "dev": "tsx bin/cli.ts"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.4.0",
    "node-html-parser": "^7.1.0",
    "openai": "^6.38.0",
    "string-width": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.7.3"
  }
}
